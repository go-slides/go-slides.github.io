# The response headers the playground is served with, as a snippet that
# Caddyfile.playground and Caddyfile.oidc import.
(playground_headers) {
	header {
		# The playground runs everything in the browser: its own scripts (some
		# inline), its WebAssembly modules and their workers, all from this
		# origin. The preview frames are sandboxed srcdoc frames with a policy
		# of their own, and inherit this one too: a deck's https: images,
		# style sheets and fonts are what they load.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' https:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: blob: https:; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}
	# Every module, worker, font and picture is requested with the
	# release's ?v=: it can be kept for a year. The rest is revalidated.
	@versioned query v=*
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@unversioned not query v=*
	header @unversioned Cache-Control "no-cache"
}
